# Results of record ARE tracked: the merged json each experiments/run_*.py --merge writes,
# which is what RESULTS.md quotes. Not tracked: the per-shard intermediates (regenerate with
# --seeds lo hi) and the snapshots of superseded protocol versions.
results/*_[0-9]*_[0-9]*.json
results/**/*_[0-9]*_[0-9]*.json
results/v4*/
results/v5*/
results/**/v6_180bank/
results/**/prerounding/
results/live_*/
expected_local/

__pycache__/
*.py[cod]
.pytest_cache/
*.egg-info/
.venv/
venv/
runs/
